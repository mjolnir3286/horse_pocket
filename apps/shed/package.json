{
  "name": "shed",
  "version": "0.1.0",
  "private": true,
  "description": "Shed — scan nutrition labels, do serving math, and log calories against a daily target",
  "type": "module",
  "scripts": {
    "ocr-assets": "node scripts/copy-ocr-assets.mjs",
    "dev": "npm run ocr-assets && vite --host 0.0.0.0 --port 4175",
    "build": "npm run ocr-assets && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4175",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
